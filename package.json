{
  "name": "napi-frontend",
  "version": "1.0.0",
  "description": "Frontend Napi",
  "main": "main.js",
  "author": "William Wallace",
  "license": "ISC",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "devDependencies": {
    "electron": "^25.0.0",
    "electron-builder": "^26.0.12"
  },
  "dependencies": {
    "dotenv": "^16.4.5"
  },
  "build": { "appId": "com.napi.app", "productName": "NapiApp", "directories": { "output": "release", "buildResources": "assets" }, "files": [ "main.js", "frontend/**/*", "package.json" ], "extraResources": [ {
    "from": "backend/dist",
    "to": "backend/dist"
  },
  {
    "from": "backend/node_modules",
    "to": "backend/node_modules"
  },
  {
    "from": "backend/prisma",
    "to": "backend/prisma"
  },
  {
    "from": "backend/.env",
    "to": "backend/.env"
  }, { "from": "frontend/resources/detection_service.exe", "to": "detection_service.exe" }, {
      "from": "backend/resources/ffmpeg",
      "to": "backend/ffmpeg",
      "filter": ["**/*"]
    } ],
    "win": {
      "target": "nsis",
      "icon": "frontend/resources/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true
    }
  }
}
